# Fedora (latest stable release: 44 when pinned) with Fedora's own Rust,
# GTK 4 and libadwaita. The `ci` stage (docker build --target ci) runs the
# tests (ci/run.sh distro:fedora).
#
# Fedora ships current Rust releases as updates to its stable release, so the
# distro toolchain is tested here rather than a rustup one. `latest` names
# the current stable release (not rawhide); the digest pins it, the same as
# validity-rs's.
FROM fedora:latest@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80 AS ci

ENV CARGO_HOME=/usr/local/cargo
RUN dnf install -y \
        cargo \
        dbus-daemon \
        gcc \
        gtk4-devel \
        libadwaita-devel \
        rust \
    && dnf clean all \
    && rustc --version \
    && dbus-daemon --version | head -1 \
    && pkg-config --modversion gtk4 libadwaita-1

WORKDIR /src
CMD ["/bin/bash"]
