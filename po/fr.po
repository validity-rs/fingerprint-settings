# ---------------------------------------------------------------- the screen

msgid "Fingerprints"
msgstr "Empreintes digitales"

msgid "Looking for the fingerprint reader…"
msgstr "Recherche du lecteur d'empreintes…"

msgid "Right index finger registered"
msgstr "Index droit enregistré"

msgid "No fingerprint registered"
msgstr "Aucune empreinte enregistrée"

msgid "Register my right index finger"
msgstr "Enregistrer mon index droit"

msgid "Cancel"
msgstr "Annuler"

msgid "Remove"
msgstr "Supprimer"

msgid "Removing…"
msgstr "Suppression…"

msgid "Fingerprint removed."
msgstr "Empreinte supprimée."

# ---------------------------------------------------------------- enrolment

msgid "Getting the reader ready…"
msgstr "Préparation du lecteur…"

msgid "Place your finger…"
msgstr "Posez le doigt…"

msgid "Again…"
msgstr "Encore…"

msgid "Again… {passed}/{total}"
msgstr "Encore… {passed}/{total}"

msgid "Poorly read, place your finger again."
msgstr "Mal lu, reposez le doigt."

msgid "Registration complete."
msgstr "Enregistrement terminé."

msgid "Registration cancelled."
msgstr "Enregistrement annulé."

msgid "Registration failed. Try again."
msgstr "L'enregistrement a échoué. Réessayez."

msgid "The reader's memory is full."
msgstr "La mémoire du lecteur est pleine."

msgid "This finger is already registered (perhaps on another account)."
msgstr "Ce doigt est déjà enregistré (peut-être sur un autre compte)."

msgid "The fingerprint reader was disconnected."
msgstr "Le lecteur d'empreintes a été débranché."

msgid "The fingerprint reader had a problem. Try again."
msgstr "Le lecteur d'empreintes a eu un problème. Réessayez."

# ---------------------------------------------------------------- service errors

msgid "The fingerprint service is not available."
msgstr "Le service d'empreintes n'est pas disponible."

msgid "No fingerprint reader detected."
msgstr "Aucun lecteur d'empreintes détecté."

msgid "The reader is in use by another program. Try again in a moment."
msgstr "Le lecteur est utilisé par un autre programme. Réessayez dans un instant."

msgid "Permission denied."
msgstr "Autorisation refusée."

msgid "No fingerprint registered."
msgstr "Aucune empreinte enregistrée."

msgid "This finger is already registered."
msgstr "Ce doigt est déjà enregistré."

msgid "The fingerprint could not be removed. Try again."
msgstr "L'empreinte n'a pas pu être supprimée. Réessayez."

msgid "The fingerprint service is not answering. Try again."
msgstr "Le service d'empreintes ne répond pas. Réessayez."

msgid "The fingerprint service reported an error. Try again."
msgstr "Le service d'empreintes a signalé une erreur. Réessayez."
